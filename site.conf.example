# --------------------------- Notification ------------------------------------
# Only the Host Agent script sends mail (it runs as root). The HANA and cockpit
# scripts alert exclusively through Checkmk.
#MAILTO="sap-admins@example.com"

# --------------------------- Checkmk -----------------------------------------
#SPOOL_DIR="/var/lib/check_mk_agent/spool"
#CMK_SPOOL="/var/lib/check_mk_agent/spool"    # variable name in the Host Agent script

# 25h max age: if the daily run stops, the service goes stale. That is the
# monitoring watching itself -- do not raise it without a stale notification rule.
#SPOOL_MAX_AGE=90000
#CMK_MAX_AGE=90000

# Remaining-lifetime thresholds. acme.sh renews after 60 days, so crossing these
# means at least one renewal cycle was lost.
#CERT_WARN_DAYS=20
#CERT_CRIT_DAYS=10

# --------------------------- HANA objects ------------------------------------
# Naming convention. Only change these if you rename in ALL databases at once;
# the setup script and the renewal script have to agree.
#PSE_NAME="ACME_SSL"
#USTORE_KEY="ACME_RENEW"
#ACME_USER="ACME_RENEW"
#CA_CERT_NAME="ACME_ROOT_CA"

# Root CA override for chain completion. Leave unset for automatic completion
# (system trust store, then AIA download). Only needed for hosts that are
# offline and do not have the root in their trust store.
#ROOT_CA_FILE="/etc/ssl/certs/your-root-ca.pem"

# --------------------------- HANA Cockpit (XSA) ------------------------------
# From "xs orgs" and "xs spaces".
#XSA_ORG="your-org"
#XSA_SPACE="SAP"

# Dedicated technical user with the XS_CONTROLLER_ADMIN role collection:
#   xs create-user acme_renew '<pw>' --no-password-change
#   xs assign-role-collection XS_CONTROLLER_ADMIN acme_renew
#XSA_USER="acme_renew"
#XSA_PW_FILE="${HOME}/.xsa_cert_renew.pw"     # mode 600

# How long to wait for the router after the XSA restart.
#RESTART_TIMEOUT=900
#POLL_INTERVAL=15

# --------------------------- Binaries ----------------------------------------
# The scripts locate these by glob. If the glob misses on a host (check with
# "which hdbsql" / "which xs"), set the FULL path here.
#HDBSQL="/usr/sap/<SID>/HDB<nn>/exe/hdbsql"
#XS="/usr/sap/<SID>/xs/bin/xs"
#OPENSSL="/usr/bin/openssl"

# --------------------------- Per-host overrides ------------------------------
# Normally SID, FQDN and the instance number are derived at runtime. Pin them
# only for special cases such as virtual hostnames -- and remember that a shared
# site.conf applies to every host, so guard host-specific values:
#case "$(hostname -s)" in
#    special-host) FQDN="service-name.example.com" ;;
#esac
